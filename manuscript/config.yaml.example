# Code Project Configuration — ROGUE (licence_to_kill)
# Copy this file to config.yaml and customize. Identity/experiment blocks
# mirror what `src/licence_to_kill/manuscript_variables.py` reads.

paper:
  title: "Licence to Kill: ROGUE — Special-Agent Mission Software"
  subtitle: "Deterministic graph, physics, and dynamic-programming modelling of an unsanctioned operation"
  version: "0.1.0"

authors:
  - name: "Daniel Ari Friedman"
    orcid: "0000-0001-6232-9096"
    email: "daniel@activeinference.institute"
    affiliation: "Active Inference Institute"
    corresponding: true

# No DOI/registrar deposit is made, so publication metadata is deliberately
# empty here.
publication:
  github_repository: ""
  repository_url: ""
  journal: ""
  volume: ""
  pages: ""
  year: "2026"

keywords:
  - "money laundering detection"
  - "layering"
  - "integration"
  - "vessel forensics"
  - "rogue operations"
  - "dynamic programming"
  - "deterministic modelling"
  - "reproducible research"

metadata:
  license: "MIT"
  language: "en"

mission:
  film: "licence_to_kill"
  codename: "ROGUE"
  seed: 0
  laundering:
    sources: ["S1", "S2", "S3"]
    sinks: ["B1", "B2", "B3", "B4"]
    max_depth: 8
    max_cycles: 50
    max_paths: 200
  vessel:
    profile: "Wavekrest"
    observed:
      cargo_mass_t: 900.0
      declared_displacement_t: 700.0
  rogue:
    horizon: 10
    alert_max: 10
    actions: ["stealth", "covert", "overt"]
  finance:
    value_usd: 5000000.0
    denomination: 100.0
    purity: 0.6
  logistics:
    origin: "IC"
    destination: "FL"
    capacity_kg: 25.0
    endurance_nm: 4257.0
  surveillance:
    actions: 5
    detection_threshold: 0.5
